#!/usr/bin/env bash
# narchy-backgrounds — fetch theme wallpapers into ~/.config/narchy/backgrounds.
#
# Kept out of `narchy` on purpose: the tool itself never touches the network
# and needs nothing but bash and sed. This needs git, and runs about once.
#
# narchy ships no wallpapers. They belong to whoever made them, are not
# narchy's to redistribute, and the upstream set mixes freely licensed
# photography with stills and artwork that plainly are not. Fetching them
# copies someone else's files onto your disk for your own use; it does not
# make them yours. Point --repo somewhere else if you would rather not.
set -euo pipefail

REPO=${NARCHY_BACKGROUNDS_REPO:-https://github.com/basecamp/omarchy.git}
REF=${NARCHY_BACKGROUNDS_REF:-v3.8.4}

NARCHY_PATH="${NARCHY_PATH:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
NARCHY_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/narchy"
DEST="$NARCHY_CONFIG/backgrounds"

die() {
  printf 'narchy-backgrounds: %s\n' "$*" >&2
  exit 1
}

# Global, because an EXIT trap fires long after any function local is gone.
WORKDIR=""
cleanup() { [[ -n ${WORKDIR:-} ]] && rm -rf "$WORKDIR"; }
trap cleanup EXIT

usage() {
  cat <<'USAGE'
narchy-backgrounds [--list] [theme...]

  no arguments   fetch wallpapers for every theme narchy knows about
  theme...       fetch only those themes
  --list         show which themes have wallpapers upstream, and how many

Files land in ~/.config/narchy/backgrounds/<theme>/. Anything already there is
left alone, so your own pictures survive a re-run.

  NARCHY_BACKGROUNDS_REPO   default https://github.com/basecamp/omarchy.git
  NARCHY_BACKGROUNDS_REF    default v3.8.4
USAGE
}

local_themes() {
  {
    local dir
    for dir in "$NARCHY_CONFIG/themes" "$NARCHY_PATH/themes"; do
      [[ -d $dir ]] && find -L "$dir" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
    done
  } | sort -u
}

# Metadata only: --filter=blob:none means no image is fetched until checkout.
clone_index() {
  git clone --depth 1 --filter=blob:none --no-checkout --sparse \
    --branch "$REF" --quiet "$REPO" "$1" 2>/dev/null ||
    die "could not clone $REPO at $REF"
}

cmd_list() {
  WORKDIR=$(mktemp -d)
  local tmp=$WORKDIR

  clone_index "$tmp"
  git -C "$tmp" ls-tree -r --name-only HEAD -- themes |
    awk -F/ '$3 == "backgrounds" && NF == 4 { count[$2]++ }
             END { for (t in count) printf "%-20s %d\n", t, count[t] }' |
    sort
}

cmd_fetch() {
  local -a themes=("$@")
  ((${#themes[@]})) || mapfile -t themes < <(local_themes)
  ((${#themes[@]})) || die "no themes found"

  WORKDIR=$(mktemp -d)
  local tmp=$WORKDIR

  printf 'fetching from %s at %s\n' "$REPO" "$REF"
  clone_index "$tmp"

  # Cone mode takes directories, so name each one rather than globbing.
  local -a paths=()
  local theme
  for theme in "${themes[@]}"; do
    paths+=("themes/$theme/backgrounds")
  done

  git -C "$tmp" sparse-checkout set "${paths[@]}" >/dev/null 2>&1 || true
  git -C "$tmp" checkout --quiet "$REF" 2>/dev/null || true

  local copied=0 kept=0 missing=0 src dest_dir name
  for theme in "${themes[@]}"; do
    if [[ ! -d $tmp/themes/$theme/backgrounds ]]; then
      missing=$((missing + 1))
      continue
    fi

    dest_dir="$DEST/$theme"
    mkdir -p "$dest_dir"

    for src in "$tmp/themes/$theme/backgrounds"/*; do
      [[ -f $src ]] || continue
      name=$(basename "$src")
      # Never clobber: a picture you put there yourself wins.
      if [[ -e $dest_dir/$name ]]; then
        kept=$((kept + 1))
        continue
      fi
      cp "$src" "$dest_dir/$name"
      copied=$((copied + 1))
    done

    rmdir "$dest_dir" 2>/dev/null || true
  done

  printf '%d copied, %d already there, %d skipped (none upstream)\n' \
    "$copied" "$kept" "$missing"
  printf 'in %s\n' "$DEST"
}

case ${1:-} in
  -h | --help)
    usage
    ;;
  --list)
    cmd_list
    ;;
  *)
    command -v git >/dev/null 2>&1 || die "git is required"
    cmd_fetch "$@"
    ;;
esac
